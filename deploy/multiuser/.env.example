# CaDS Firmware Lab multi-user stack - copy to .env (chmod 600).  Used by
#   * docker compose (fl-gate / fl-agent)            -> CT_*, FL_GATE_*, FL_BROKER_ADDR
#   * the broker (systemd EnvironmentFile / watchdog) -> FL_*, TUTOR_LLM_*
# Never commit .env.

# ---- gate (Caddy) ---------------------------------------------------------------------------
CT_GATE_UPSTREAM_HOST=bunsenbrenner.org      # edge that answers /gate/check (Keycloak, realm ct-demo)
CT_GATE_SCHEME=https                         # http ONLY for the local stub gate
CT_GATE_PUBLIC_URL=https://bunsenbrenner.org # browser-facing gate address (/logout redirect)
FL_GATE_LISTEN=127.0.0.1:3000                # Linux/host network; compose.desktop.yml overrides
FL_BROKER_ADDR=127.0.0.1:3100                # how Caddy reaches the broker

# ---- ct-agent (only with: docker compose --profile agent up -d) -----------------------------
CT_AGENT_ORIGIN=127.0.0.1:3000               # the gate, never a student container
CT_AGENT_HOSTNAME=firmware-lab-34a13a96.bunsenbrenner.org
CT_AGENT_JOIN_TOKEN=                         # single-use token from the portal (secret)

# ---- broker (host process) ------------------------------------------------------------------
FL_IMAGE=cads-firmware-lab:latest            # image for every student container
FL_ADMIN_EMAILS=                             # comma-separated; may open /admin (stop/wipe)
FL_MAX_SESSIONS=40                           # running containers; beyond -> 503 "Labor voll"
FL_IDLE_STOP_MIN=240                         # stop after this many idle minutes (last-seen AND heartbeat)
FL_MEM=2g
FL_CPUS=2
FL_PIDS_LIMIT=2048
FL_UPSTREAM_HOST=127.0.0.1                   # host part of X-FL-Upstream; host.docker.internal on Docker Desktop
FL_PUBLISH_HOST=127.0.0.1                    # docker -p <this>:0:8080 (keep loopback)
FL_WORKSPACE_DIR=/home/coder/workspace/cads-zero
#FL_EXTRA_CODE_ARGS=--app-name "CaDS Firmware Lab" --disable-telemetry --disable-update-check

# ---- tutor LLM (injected by the broker into every container; never baked into the image) ----
TUTOR_LLM_BASE_URL=https://llm-34a13a96.bunsenbrenner.org/v1
TUTOR_LLM_API_KEY=                           # secret
TUTOR_LLM_MODEL=local-devstral-small2
