# CaDS Tutor Lab deployment - copy to .env (gitignored) and fill in.
#   cp .env.example .env && $EDITOR .env
# compose.yml, deploy.sh, smoke.sh and llm-check.sh all read this file.

# --- required ---------------------------------------------------------------
# The shared student login (code-server's $PASSWORD). Generate one with
#   openssl rand -hex 12
TUTOR_LAB_PASSWORD=

# --- image ------------------------------------------------------------------
# Always an immutable tag (next-<shortsha> from CI, or a release tag). Never
# `next` or `latest`: a moving tag leaves a rollback with nothing to roll back
# to. deploy.sh --tag <tag> overrides this for one run.
TUTOR_LAB_TAG=next-b5f435f

# --- language model ---------------------------------------------------------
# All three together or none. Without them the tutor still teaches, but every
# comprehension question falls back to self-assessment and the help levels stay
# empty. Check them with ./llm-check.sh before a class uses the lab.
# The base URL MUST start with https:// - the client refuses anything else.
TUTOR_LLM_BASE_URL=https://llm2.example.org/v1
TUTOR_LLM_API_KEY=
TUTOR_LLM_MODEL=local-devstral-small2

# --- teacher portal (SPEC A5, not consumed by cads-tutor@0.1.0 yet) ----------
CADS_TUTOR_TELEMETRY_URL=
CADS_TUTOR_TELEMETRY_TOKEN=

# --- host wiring (defaults match the lab host; change only with reason) ------
# The tunnel on the lab host targets 127.0.0.1:8084.
TUTOR_LAB_PORT=8084
TUTOR_LAB_CONTAINER=tutor-lab
# The named volume holding student work. If the container that runs today uses
# a different name, put THAT name here - deploy.sh compares the two and refuses
# to start rather than hand the students an empty workspace. Read it with:
#   docker inspect tutor-lab --format '{{range .Mounts}}{{.Name}}{{end}}'
TUTOR_LAB_VOLUME=tutor-lab-workspace
