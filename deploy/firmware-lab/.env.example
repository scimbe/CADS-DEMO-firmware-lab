# CaDS Firmware Lab deployment (services host) - copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
# deploy.sh and smoke.sh read this file. A value already in the environment
# wins over the file.

# --- required ---------------------------------------------------------------
# The shared student login (code-server's $PASSWORD).
FIRMWARE_LAB_PASSWORD=

# Always an immutable tag (next-<shortsha> from CI). Never `next` or `latest`:
# a moving tag leaves a rollback with nothing to roll back to.
FIRMWARE_LAB_TAG=next-76e083c

# --- language model ---------------------------------------------------------
# On this host the tutor runs with a real model, not in self-assessment
# fallback: deploy.sh refuses to deploy without all three (--allow-no-llm
# overrides), and smoke.sh asks the endpoint whether it really answers.
# The base URL MUST start with https:// - the client refuses anything else.
TUTOR_LLM_BASE_URL=https://llm-34a13a96.bunsenbrenner.org/v1
TUTOR_LLM_API_KEY=
TUTOR_LLM_MODEL=local-devstral-small2

# --- host wiring (defaults match the services host) --------------------------
# The ct-agent tunnel targets 127.0.0.1:8083.
FIRMWARE_LAB_PORT=8083
FIRMWARE_LAB_CONTAINER=firmware-lab
FIRMWARE_LAB_VOLUME=firmware-lab-workspace
# The public address the tunnel serves. Optional: when set, smoke.sh also
# checks the lab through the tunnel, which is how a student reaches it.
FIRMWARE_LAB_PUBLIC_URL=

# --- resources --------------------------------------------------------------
# The services host is small. Limits cmake's parallelism inside the container;
# unset = as many jobs as the host has cores.
CMAKE_BUILD_PARALLEL_LEVEL=2
# Free disk deploy.sh insists on beyond what the pull itself needs, in GB.
# The image unpacks to about 3.8 GB and downloads about 1 GB.
FIRMWARE_LAB_DISK_HEADROOM_GB=1
