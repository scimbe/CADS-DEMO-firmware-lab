# Copy to .env (gitignored) and fill in real values. docker-compose.yml and
# scripts/run-local.sh read this file.

# Login password for the browser IDE (code-server's $PASSWORD). Required.
FIRMWARE_LAB_PASSWORD=choose-a-real-password

# Host port on 127.0.0.1 for local runs (compose / run-local.sh). The lab
# deployment maps 8083; locally 8084 keeps out of its way.
FIRMWARE_LAB_PORT=8084

# Tutor LLM (cads-tutor extension, @cads/tutor-platform). Optional: without
# these the tutor still runs, only the "ask the tutor" dialog is unavailable.
# MUST be https (the endpoint 308-redirects http and clients drop the
# Authorization header across the scheme change -> silent 401s).
TUTOR_LLM_BASE_URL=https://llm-34a13a96.bunsenbrenner.org/v1
TUTOR_LLM_API_KEY=sk-...
TUTOR_LLM_MODEL=local-devstral-small2

# Build-time only (not passed into the container): the cads-zero commit to seed.
# CADS_ZERO_REF=e882fabd347c0b5ca04a7668b50be1d005924cb9
