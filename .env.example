# Copy this file to .env (gitignored) and fill in real values.
# docker-compose.yml passes these through; they only affect the tutor mode's optional
# "Ask about this step" panel -- the rest of firmware-lab (browser IDE, OpenOCD, USB
# passthrough) needs none of this and runs the same with .env absent entirely.

# Same convention as the other CADS-DEMO-* repos (codereview, distributed-rag, ...).
# Leave unset and the Ask panel reports itself unconfigured instead of erroring.
#
# MUST be https, not http: this host force-redirects http->https with a 308, and standard HTTP
# clients (fetch, curl, etc.) drop the Authorization header across a scheme-changing redirect by
# design (security-sensitive). Using http here doesn't error at startup -- it silently 401s on
# every real request. Confirmed live (Maintainer cads zero, 2026-08-30): http one-hop -> 308,
# same request against https directly -> 200 with a real model list.
LITELLM_BASE_URL=https://llm-34a13a96.bunsenbrenner.org/v1
LITELLM_API_KEY=sk-...
LITELLM_DEFAULT_MODEL=local-devstral-small2
