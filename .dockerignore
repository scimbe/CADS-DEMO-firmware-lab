# Keep the build context small and secret-free.
.git
.env
.env.*
!.env.example
docs
tests
scripts
e2e
courses
README.md
webusb-flash
example-firmware
vscode-extension
**/node_modules
**/.vscode-test
**/build
# extensions/: only the packaged VSIX files from the other streams go into the
# image, never sources or node_modules. .gitkeep keeps the directory present
# so `COPY extensions/` cannot fail on a checkout without any VSIX yet.
extensions/**
!extensions/.gitkeep
!extensions/*/dist/*.vsix
