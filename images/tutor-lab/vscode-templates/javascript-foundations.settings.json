{
  // cads-tutor-lab: managed by the image (images/tutor-lab/vscode-templates).
  // Rewritten on container start while this line is present; remove it to
  // keep your own settings.
  //
  // ONLY settings of scope "resource" belong here - VS Code silently ignores
  // window- and application-scoped ones in a folder's .vscode/settings.json.
  // That is why js/ts.implicitProjectConfig.* (window) lives in the image's
  // user settings instead; putting it here looked right and did nothing.
  //
  // eslint.enable is true only when the workspace has an ESLint configuration
  // (decided per start by entrypoint.d/10-seed-workspaces.sh); otherwise the
  // extension would report a missing library on every file.
  "eslint.enable": __CADS_ESLINT_ENABLE__,
  "eslint.useFlatConfig": true,
  "javascript.suggest.autoImports": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true
  }
}
