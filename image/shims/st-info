#!/usr/bin/env python3
"""st-info shim for the CaDS Firmware Lab (SPEC.md §3.2).

    st-info --probe          -> GET /probe on the board bridge, printed verbatim
    st-info --serial|--chipid|--flash|--sram|--descr|--pagesize
                             -> the matching field from the same probe output
    st-info --version

The bridge renders GET /probe in stlink's own st-info format, e.g.

    Found 1 stlink programmers
      version:    V2J37S26
      serial:     066FFF565282494867161033
      flash:      2097152 (pagesize: 16384)
      sram:       196608
      chipid:     0x419
      dev-type:   STM32F42x_F43x

so anything that parses st-info output keeps working.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cads_shim_common as shim  # noqa: E402

VERSION = "st-info 1.8.0 (CaDS lab shim, board-bridge HTTP)"
USAGE = """usage: st-info --probe
       st-info --serial | --chipid | --flash | --sram | --descr | --pagesize
       st-info --version
"""

FIELD_FLAGS = {
    "--serial": "serial",
    "--chipid": "chipid",
    "--flash": "flash",
    "--sram": "sram",
    "--descr": "dev-type",
    "--pagesize": "pagesize",
}


def fetch_probe() -> str:
    body = shim.request("GET", "/probe", timeout=15.0)
    return body.decode("utf-8", "replace")


def parse_fields(text: str) -> dict[str, str]:
    """Turn '  key:   value' lines into a dict; 'flash: N (pagesize: M)' yields both."""
    fields: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        key, value = key.strip(), value.strip()
        if not key:
            continue
        if "(" in value and value.endswith(")"):
            main, _, extra = value.partition("(")
            fields[key] = main.strip()
            ek, _, ev = extra[:-1].partition(":")
            if ek.strip():
                fields[ek.strip()] = ev.strip()
        else:
            fields[key] = value
    return fields


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE, file=sys.stderr if not argv else sys.stdout)
        return 1 if not argv else 0
    flag = argv[0]
    if flag == "--version":
        print(VERSION)
        return 0
    if flag != "--probe" and flag not in FIELD_FLAGS:
        print(USAGE, file=sys.stderr)
        return shim.fail(f"unknown option {flag}")

    try:
        text = fetch_probe()
    except shim.BridgeOffline:
        return shim.fail_offline()
    except shim.BridgeError as exc:
        return shim.fail(f"probe failed: {exc}")

    if flag == "--probe":
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
        return 0

    fields = parse_fields(text)
    wanted = FIELD_FLAGS[flag]
    if wanted not in fields:
        return shim.fail(f"bridge probe output has no '{wanted}' field")
    print(fields[wanted])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
