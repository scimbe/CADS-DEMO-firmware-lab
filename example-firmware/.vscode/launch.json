{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug on hardware (OpenOCD)",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/firmware.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "gdbPath": "gdb-multiarch",
      "configFiles": ["${workspaceFolder}/openocd.cfg"],
      "preLaunchTask": "Build firmware",
      "runToEntryPoint": "main"
    }
  ]
}
