{
  "name": "cads-board-bridge",
  "displayName": "CaDS Board Bridge",
  "description": "GDB remote server, serial console and flash commands for the board attached to the student's browser (via cads-probe).",
  "publisher": "cads",
  "version": "0.1.3",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onDebugResolve:cortex-debug"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cads.bridge.ping",
        "title": "CaDS Bridge: Ping probe (host capabilities)"
      },
      {
        "command": "cads.board.connect",
        "title": "CaDS Board: Verbinden (USB/Serial freigeben)",
        "category": "CaDS"
      },
      {
        "command": "cads.board.disconnect",
        "title": "CaDS Board: Trennen",
        "category": "CaDS"
      },
      {
        "command": "cads.board.flash",
        "title": "CaDS Board: Flash (build/itsboard/cads-zero.bin)",
        "category": "CaDS"
      },
      {
        "command": "cads.board.reset",
        "title": "CaDS Board: Reset",
        "category": "CaDS"
      },
      {
        "command": "cads.board.halt",
        "title": "CaDS Board: Anhalten",
        "category": "CaDS"
      },
      {
        "command": "cads.board.run",
        "title": "CaDS Board: Weiterlaufen lassen",
        "category": "CaDS"
      },
      {
        "command": "cads.board.openConsole",
        "title": "CaDS Board: Konsole öffnen",
        "category": "CaDS"
      },
      {
        "command": "cads.board.status",
        "title": "CaDS Board: Status (JSON)",
        "category": "CaDS"
      },
      {
        "command": "cads.board.showPanel",
        "title": "CaDS Board: Log anzeigen",
        "category": "CaDS"
      },
      {
        "command": "cads.board.showMenu",
        "title": "CaDS Board: Menü",
        "category": "CaDS"
      },
      {
        "command": "cads.board.release",
        "title": "CaDS Board: Board freigeben (für einen anderen Tab)"
      }
    ],
    "configuration": {
      "title": "CaDS Board Bridge",
      "properties": {
        "cads.board.gdbPort": {
          "type": "number",
          "default": 3333,
          "description": "GDB-RSP-Server-Port (127.0.0.1)"
        },
        "cads.board.serialPort": {
          "type": "number",
          "default": 3334,
          "description": "Serial-TCP-Port (127.0.0.1)"
        },
        "cads.board.httpPort": {
          "type": "number",
          "default": 3335,
          "description": "HTTP-Shim-API-Port (127.0.0.1)"
        },
        "cads.board.baud": {
          "type": "number",
          "default": 115200,
          "description": "Baudrate der Board-Konsole"
        },
        "cads.board.consoleLink": {
          "type": "string",
          "default": "/home/coder/board-console",
          "description": "PTY-Link für socat (nur wenn socat vorhanden)"
        },
        "cads.board.defaultImage": {
          "type": "string",
          "default": "build/itsboard/cads-zero.bin",
          "description": "Standard-Image für cads.board.flash (relativ zum Workspace)"
        },
        "cads.board.gdbPath": {
          "type": "string",
          "default": "arm-none-eabi-gdb",
          "description": "GDB für cortex-debug (arm-none-eabi-gdb oder gdb-multiarch)"
        },
        "cads.board.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Ausführliches Log (RSP-Pakete, serielle Zeilen)"
        },
        "cads.board.httpCommandsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "POST /command auf dem HTTP-Shim-Port erlauben (nur 127.0.0.1; für Tests/Tooling)"
        },
        "cads.board.idleReleaseSeconds": {
          "type": "number",
          "default": 0,
          "description": "Gib das Board automatisch frei, wenn das Fenster so viele Sekunden lang nicht im Vordergrund war. 0 schaltet die automatische Freigabe aus."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "node esbuild.mjs --tests && node --test out/test/*.test.js",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies -o dist/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
