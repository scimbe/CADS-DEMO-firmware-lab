{
  "name": "cads-tutor",
  "displayName": "CaDS Tutor",
  "description": "Kurs-Tutor für die CaDS-Zero-Firmware: Kurse als Plugins, Fortschritt, automatische Checks, sokratische Begleitung (Bloom-Taxonomie).",
  "version": "0.1.0",
  "publisher": "cads",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/scimbe/CADS-DEMO-firmware-lab.git"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "cads",
    "tutor",
    "firmware",
    "stm32",
    "education"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "cadsTutorCourses": [],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cads-tutor",
          "title": "CaDS Tutor",
          "icon": "media/tutor.svg"
        }
      ]
    },
    "views": {
      "cads-tutor": [
        {
          "id": "cadsTutor.courses",
          "name": "%views.cads-tutor.0.name%",
          "icon": "media/tutor.svg",
          "contextualTitle": "CaDS Tutor"
        },
        {
          "id": "cadsTutor.progress",
          "name": "%views.cads-tutor.1.name%",
          "icon": "media/tutor.svg",
          "contextualTitle": "CaDS Tutor",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cadsTutor.courses",
        "contents": "%viewsWelcome.0.contents%"
      }
    ],
    "commands": [
      {
        "command": "cads.tutor.open",
        "title": "%commands.0.title%",
        "category": "CaDS Tutor",
        "icon": "$(mortar-board)"
      },
      {
        "command": "cads.tutor.gotoStep",
        "title": "%commands.1.title%",
        "category": "CaDS Tutor"
      },
      {
        "command": "cads.tutor.runChecks",
        "title": "%commands.2.title%",
        "category": "CaDS Tutor",
        "icon": "$(run-all)"
      },
      {
        "command": "cads.tutor.ask",
        "title": "%commands.3.title%",
        "category": "CaDS Tutor",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cads.tutor.reloadCourses",
        "title": "%commands.4.title%",
        "category": "CaDS Tutor",
        "icon": "$(refresh)"
      },
      {
        "command": "cads.tutor.resetProgress",
        "title": "%commands.5.title%",
        "category": "CaDS Tutor"
      },
      {
        "command": "cads.tutor.setLanguage",
        "title": "%commands.6.title%",
        "category": "CaDS Tutor",
        "icon": "$(globe)"
      },
      {
        "command": "cads.tutor.nextStep",
        "title": "%commands.7.title%",
        "category": "CaDS Tutor"
      },
      {
        "command": "cads.tutor.prevStep",
        "title": "%commands.8.title%",
        "category": "CaDS Tutor"
      },
      {
        "command": "cads.tutor.showOutput",
        "title": "%commands.9.title%",
        "category": "CaDS Tutor"
      },
      {
        "command": "cads.tutor.showOrientation",
        "title": "%commands.10.title%",
        "category": "CaDS Tutor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cads.tutor.reloadCourses",
          "when": "view == cadsTutor.courses",
          "group": "navigation@1"
        },
        {
          "command": "cads.tutor.setLanguage",
          "when": "view == cadsTutor.courses",
          "group": "navigation@2"
        },
        {
          "command": "cads.tutor.runChecks",
          "when": "view == cadsTutor.courses",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "cads.tutor.gotoStep",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "CaDS Tutor",
      "properties": {
        "cadsTutor.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.cadsTutor.autoOpen.description%"
        },
        "cadsTutor.language": {
          "type": "string",
          "enum": [
            "auto",
            "de",
            "en"
          ],
          "default": "auto",
          "description": "%configuration.properties.cadsTutor.language.description%"
        },
        "cadsTutor.checkInOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.cadsTutor.checkInOnSave.description%"
        },
        "cadsTutor.buildTaskLabel": {
          "type": "string",
          "default": "CaDS: Build",
          "description": "%configuration.properties.cadsTutor.buildTaskLabel.description%"
        },
        "cadsTutor.extraCourseDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.properties.cadsTutor.extraCourseDirs.description%"
        },
        "cadsTutor.llm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-kompatibler Endpunkt (https). Fallback für TUTOR_LLM_BASE_URL. Der API-Key kommt ausschließlich aus TUTOR_LLM_API_KEY."
        },
        "cadsTutor.llm.model": {
          "type": "string",
          "default": "",
          "description": "Modellname. Fallback für TUTOR_LLM_MODEL."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "cadsTutor.gettingStarted",
        "title": "%walkthroughs.0.title%",
        "description": "%walkthroughs.0.description%",
        "steps": [
          {
            "id": "cadsTutor.walk.connect",
            "title": "%walkthroughs.0.steps.0.title%",
            "description": "%walkthroughs.0.steps.0.description%",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:cads.board.connect"
            ]
          },
          {
            "id": "cadsTutor.walk.build",
            "title": "%walkthroughs.0.steps.1.title%",
            "description": "%walkthroughs.0.steps.1.description%",
            "media": {
              "markdown": "media/walkthrough/build.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.tasks.build"
            ]
          },
          {
            "id": "cadsTutor.walk.flash",
            "title": "%walkthroughs.0.steps.2.title%",
            "description": "%walkthroughs.0.steps.2.description%",
            "media": {
              "markdown": "media/walkthrough/flash.md"
            },
            "completionEvents": [
              "onCommand:cads.board.flash"
            ]
          },
          {
            "id": "cadsTutor.walk.debug",
            "title": "%walkthroughs.0.steps.3.title%",
            "description": "%walkthroughs.0.steps.3.description%",
            "media": {
              "markdown": "media/walkthrough/debug.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.debug.start"
            ]
          },
          {
            "id": "cadsTutor.walk.tutor",
            "title": "%walkthroughs.0.steps.4.title%",
            "description": "%walkthroughs.0.steps.4.description%",
            "media": {
              "markdown": "media/walkthrough/tutor.md"
            },
            "completionEvents": [
              "onCommand:cads.tutor.open"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile-tests",
    "test": "node --test \"out-test/test/**/*.test.js\"",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies -o dist/cads-tutor.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@cads/tutor-platform": "github:scimbe/CADS-DEMO-tutor-platform#v0.12.0",
    "markdown-it": "^14.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "github:scimbe/CADS-DEMO-tutor-platform#aca76ecb4ccb493bad921a9be90448b7215f52c1": true,
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.25.12": true,
    "keytar@7.9.0": true
  }
}
